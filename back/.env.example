NODE_ENV=development
PORT=5001
MONGO_DB_URL=mongodb://127.0.0.1:27017/uninet
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-64-character-hex-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Optional: error alerts in production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: S3-compatible file storage
PS_CLOUD_URL=
PS_CLOUD_ACCESS_KEY=
PS_CLOUD_SECRET_KEY=
TEMP_FILES_DIR=upload
